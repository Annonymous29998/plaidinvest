LOGIN_EMAIL=you@email.com
LOGIN_PASSWORD=your-password

# ── Vercel (live site: https://www.plaidinvest.online) ─────────────────────
# Add the same keys in Project → Settings → Environment Variables, then redeploy.
# The build runs scripts/generate-env.py → js/env.js (not committed to git).
#
# Required for Jerry login on live:
#   LOGIN_EMAIL, LOGIN_PASSWORD
#
# Lawson and Sarah profiles are hardcoded in js/config.js (not env).
#
# Required for matching local dashboard state:
#   DISPLAY_NAME, ACCOUNT_BALANCE, WITHDRAWAL_FEE_USD
#
# Platform BTC wallet is encoded in js/config.js (see scripts/encode-wallet.py).
#
# Cross-device account sync (Vercel → Storage → Upstash Redis, or add manually):
#   UPSTASH_REDIS_REST_URL=https://....upstash.io
#   UPSTASH_REDIS_REST_TOKEN=your-token
#   ACCOUNT_SYNC_TOKENS={"jerry":"jry_sync_8f3k2m9x","lawson":"lws_sync_4p7n1q6v","sarah":"sar_sync_2h8k5w3z"}
#
# Without Upstash, the site still works but state stays in the browser only.
#
# Local preview:
#   python3 scripts/generate-env.py && python3 -m http.server 8080
